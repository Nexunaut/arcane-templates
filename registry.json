{
  "$schema": "https://github.com/getarcaneapp/arcane-templates/schema.json",
  "name": "Nexunaut Templates",
  "description": "Personal Docker templates",
  "version": "1.0.1",
  "author": "Danny",
  "url": "https://github.com/Nexunaut/arcane-templates",
  "templates": [
    {
      "id": "gluetun",
      "name": "Gluetun VPN (Mullvad)",
      "description": "Gluetun VPN container configured for Mullvad WireGuard",
      "version": "1.0.0",
      "author": "Danny",
      "compose_url": "https://raw.githubusercontent.com/Nexunaut/arcane-templates/main/gluetun/docker-compose.yml",
      "env_url": "https://raw.githubusercontent.com/Nexunaut/arcane-templates/main/gluetun/.env.example",
      "tags": ["vpn", "networking"]
    },
    {
      "id": "pihole",
      "name": "Pi-hole",
      "description": "Network-wide DNS ad blocking",
      "version": "1.0.0",
      "author": "Danny",
      "compose_url": "https://raw.githubusercontent.com/Nexunaut/arcane-templates/main/pihole/docker-compose.yml",
      "env_url": "https://raw.githubusercontent.com/Nexunaut/arcane-templates/main/pihole/.env.example",
      "tags": ["dns", "networking"]
    },
    {
    "id": "sabnzbd",
    "name": "SABnzbd",
    "description": "Usenet download client, tunneled through Gluetun",
    "version": "1.0.0",
    "author": "Danny",
    "compose_url": "https://raw.githubusercontent.com/Nexunaut/arcane-templates/main/sabnzbd/docker-compose.yml",
    "env_url": "https://raw.githubusercontent.com/Nexunaut/arcane-templates/main/sabnzbd/.env.example",
    "tags": ["arr-stack", "downloads", "vpn"]
  },
  {
    "id": "radarr",
    "name": "Radarr",
    "description": "Movie collection manager, works with SABnzbd + Prowlarr",
    "version": "1.0.0",
    "author": "Danny",
    "compose_url": "https://raw.githubusercontent.com/Nexunaut/arcane-templates/main/radarr/docker-compose.yml",
    "env_url": "https://raw.githubusercontent.com/Nexunaut/arcane-templates/main/radarr/.env.example",
    "tags": ["arr-stack", "movies"]
  },
  {
    "id": "prowlarr",
    "name": "Prowlarr",
    "description": "Indexer manager for the *arr stack",
    "version": "1.0.0",
    "author": "Danny",
    "compose_url": "https://raw.githubusercontent.com/Nexunaut/arcane-templates/main/prowlarr/docker-compose.yml",
    "env_url": "https://raw.githubusercontent.com/Nexunaut/arcane-templates/main/prowlarr/.env.example",
    "tags": ["arr-stack", "indexer"]
  },
  {
    "id": "sonarr",
    "name": "Sonarr",
    "description": "TV series collection manager, works with SABnzbd + Prowlarr",
    "version": "1.0.0",
    "author": "Danny",
    "compose_url": "https://raw.githubusercontent.com/Nexunaut/arcane-templates/main/sonarr/docker-compose.yml",
    "env_url": "https://raw.githubusercontent.com/Nexunaut/arcane-templates/main/sonarr/.env.example",
    "tags": ["arr-stack", "tv"]
  }
  ]
}
